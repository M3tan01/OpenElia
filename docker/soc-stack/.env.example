# soc-stack environment — copy to .env and fill in real values.
# .env must be in .gitignore. Never commit real secrets.
# Generate strong random values with: openssl rand -hex 32

TZ=UTC

# --- MariaDB (MISP backend) ---
MYSQL_USER=misp
MYSQL_PASSWORD=changeme_set_strong_password
MYSQL_ROOT_PASSWORD=changeme_set_strong_root_password
MYSQL_DATABASE=misp

# --- Redis/Valkey (MISP cache/queue) ---
REDIS_PASSWORD=changeme_set_strong_password

# --- MISP core ---
BASE_URL=https://localhost
CORE_HTTP_PORT=8080
CORE_HTTPS_PORT=8443
DISABLE_IPV6=true
DISABLE_SSL_REDIRECT=true
ENABLE_BACKGROUND_UPDATES=true
# openssl rand -hex 16
ENCRYPTION_KEY=changeme_generate_32_char_hex
# openssl rand -hex 16
SALT=changeme_generate_random_salt
# uuidgen
MISP_UUID=changeme_generate_uuid
ADMIN_EMAIL=admin@admin.test
MISP_CONTACT=admin@admin.test
MISP_EMAIL=admin@admin.test
ADMIN_PASSWORD=changeme_set_strong_password
# openssl rand -hex 20
ADMIN_KEY=changeme_generate_admin_api_key
ADMIN_ORG=ORGNAME
GPG_PASSPHRASE=changeme_set_gpg_passphrase

# --- Cortex (observable analysis) ---
# openssl rand -hex 32
CORTEX_SECRET_KEY=changeme_generate_cortex_secret_key

# --- Mail relay (optional smarthost; leave blank for local-only) ---
SMARTHOST_ADDRESS=
SMARTHOST_PORT=
SMARTHOST_USER=
SMARTHOST_PASSWORD=
SMARTHOST_ALIASES=
