# soc-stack environment — copy to .env and fill in real values.
# .env must be in .gitignore (it is). Never commit real secrets.
# Generate strong random values with: openssl rand -hex 32

# --- General ---
TZ=UTC

# --- Image versions (pinned; bump after verifying the tag exists) ---
# Knowledge of current tags drifts — check the registry before trusting a default.
THEHIVE_VERSION=5.7.5
N8N_VERSION=1.70.3
ELASTIC_VERSION=7.17.9
CORTEX_VERSION=3.1.8

# --- Host ports (all bound to 127.0.0.1 by the compose file) ---
THEHIVE_PORT=9000
N8N_PORT=5678
CORTEX_PORT=9001

# --- n8n auth (REQUIRED — compose refuses to start without these) ---
N8N_BASIC_AUTH_USER=admin
# Set a real password and a 32-byte hex encryption key:
#   openssl rand -hex 24   ->  N8N_BASIC_AUTH_PASSWORD
#   openssl rand -hex 32   ->  N8N_ENCRYPTION_KEY
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=

# --- n8n public REST API key (OPTIONAL — enables workflow auto-import) ---
# Leave blank on the very first bring-up. After n8n is up, log in once at
# http://127.0.0.1:5678, then: Settings -> n8n API -> Create an API key.
# Paste it here and re-run ./deploy.sh — it will POST workflows/n8n/*.json to
# the REST API (header: X-N8N-API-KEY) so the playbooks appear in the editor.
# Without it, import is skipped and you import the JSONs manually via the UI.
N8N_API_KEY=
