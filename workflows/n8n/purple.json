{
  "name": "OpenElia — Purple Playbook",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "c1a8c2d4-1f3a-4b6c-8d21-0f1a2b3c4d5e",
      "name": "Purple Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "purple",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "c2b9c3d5-2a4b-4c7d-9e32-1a2b3c4d5e6f",
      "name": "Launch Purple Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [240, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/api/n8n/trigger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"domain\": \"purple\", \"target\": $json.body.target, \"task\": $json.body.task || \"Full purple-team assessment\", \"stealth\": $json.body.stealth || false, \"brain_tier\": $json.body.brain_tier || \"local\", \"apt_profile\": $json.body.apt_profile || null, \"agent\": $json.body.agent || null, \"campaign_id\": $json.body.campaign_id || null, \"callback_url\": \"http://localhost:5678/webhook/purple-callback\", \"confirm\": true } }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "c3a0d4e6-3b5c-4d8e-af43-2b3c4d5e6f70",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [480, -100],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"run_id\": $json.run_id, \"status\": $json.status, \"accepted\": true } }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "c4b1e5f7-4c6d-4e9f-b054-3c4d5e6f7081",
      "name": "Respond Launch Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [480, 120],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"accepted\": false, \"error\": \"engine trigger failed\", \"detail\": ($json.error && $json.error.message) || \"unreachable or rejected\" } }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "c5c2f608-5d7e-4fa0-8165-4d5e6f708192",
      "name": "Purple Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 320],
      "parameters": {
        "httpMethod": "POST",
        "path": "purple-callback",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "c6d30719-6e8f-40b1-9276-5e6f708192a3",
      "name": "Run Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [240, 320],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2c9e4d1-3b5f-4a7c-8e12-9f0a1b2c3d4e",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c7e4182a-7f90-41c2-a387-6f708192a3b4",
      "name": "Coverage Gap?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [480, 240],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3d0f5e2-4c6a-4b8d-9f23-0a1b2c3d4e5f",
              "leftValue": "={{ $json.body.coverage_pct }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c8f5293b-8001-42d3-b498-708192a3b4c5",
      "name": "TheHive Gap Case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [720, 140],
      "parameters": {
        "method": "POST",
        "url": "http://thehive:9000/api/v1/case",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"title\": \"Detection gap — OpenElia purple run \" + $json.body.run_id + \" (\" + $json.body.coverage_pct + \"% coverage)\", \"description\": \"Domain: purple\\nTask: \" + $json.body.task + \"\\nTargets: \" + JSON.stringify($json.body.targets) + \"\\nCoverage: \" + $json.body.coverage_pct + \"%\\nCaught TTPs: \" + JSON.stringify($json.body.caught_ttps) + \"\\nMissed TTPs: \" + JSON.stringify($json.body.missed_ttps) + \"\\n\\nResult:\\n\" + ($json.body.result || \"(none)\"), \"severity\": 3, \"tags\": [\"openelia\", \"purple\", \"detection-gap\", \"automated\"] } }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "c9a6304c-9012-43e4-b5a9-8192a3b4c5d6",
      "name": "TheHive Case",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [720, 340],
      "parameters": {
        "method": "POST",
        "url": "http://thehive:9000/api/v1/case",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"title\": \"OpenElia purple run \" + $json.body.run_id + \" (\" + $json.body.coverage_pct + \"% coverage)\", \"description\": \"Domain: purple\\nTask: \" + $json.body.task + \"\\nTargets: \" + JSON.stringify($json.body.targets) + \"\\nCoverage: \" + $json.body.coverage_pct + \"%\\nCaught TTPs: \" + JSON.stringify($json.body.caught_ttps) + \"\\nMissed TTPs: \" + JSON.stringify($json.body.missed_ttps) + \"\\n\\nResult:\\n\" + ($json.body.result || \"(none)\"), \"severity\": 2, \"tags\": [\"openelia\", \"purple\", \"automated\"] } }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "ca07415d-a123-44f5-c6ba-92a3b4c5d6e7",
      "name": "TheHive Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [480, 440],
      "parameters": {
        "method": "POST",
        "url": "http://thehive:9000/api/v1/alert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"type\": \"openelia-failure\", \"source\": \"openelia\", \"sourceRef\": $json.body.run_id, \"title\": \"OpenElia purple run did not complete (\" + $json.body.status + \")\", \"description\": \"Domain: purple\\nStatus: \" + $json.body.status + \"\\nError: \" + ($json.body.error || \"(none)\"), \"severity\": 2, \"tags\": [\"openelia\", \"purple\", \"failure\"] } }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
    "Purple Trigger": {
      "main": [
        [{ "node": "Launch Purple Engine", "type": "main", "index": 0 }]
      ]
    },
    "Launch Purple Engine": {
      "main": [
        [{ "node": "Respond Accepted", "type": "main", "index": 0 }],
        [{ "node": "Respond Launch Failed", "type": "main", "index": 0 }]
      ]
    },
    "Purple Callback": {
      "main": [
        [{ "node": "Run Completed?", "type": "main", "index": 0 }]
      ]
    },
    "Run Completed?": {
      "main": [
        [{ "node": "Coverage Gap?", "type": "main", "index": 0 }],
        [{ "node": "TheHive Alert", "type": "main", "index": 0 }]
      ]
    },
    "Coverage Gap?": {
      "main": [
        [{ "node": "TheHive Gap Case", "type": "main", "index": 0 }],
        [{ "node": "TheHive Case", "type": "main", "index": 0 }]
      ]
    }
  }
}
